  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "preview": "vite preview",
    "build": "node build-ruffle.js && node build-emulatorjs.js && vite build",
    "deploy": "pnpm run build && wrangler pages deploy .svelte-kit/cloudflare",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "better-auth generate --config src/lib/server/auth.js --output src/lib/server/db/auth.schema.js --yes"
  },
  "devDependencies": {
    "@inlang/cli": "^3.1.14",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "svelte": "^5.56.3",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.16",
    "wrangler": "^4.103.0"
  },
  "dependencies": {
    "7zip-min": "^3.0.1",
    "@auth/d1-adapter": "^1.11.2",
    "@auth/sveltekit": "^1.11.2",
    "@babel/runtime": "^8.0.0",
    "@better-auth/cli": "^1.4.21",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/view": "^6.43.1",
    "@dicebear/core": "^10.3.0",
    "@dicebear/styles": "^10.2.0",
    "@icons-pack/svelte-simple-icons": "^7.2.0",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.21.0",
    "@ruffle-rs/ruffle": "0.3.0",
    "@svelte-put/cloudflare-turnstile": "^1.2.0",
    "@uiw/codemirror-extensions-color": "^4.25.10",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.20",
    "drizzle": "link:better-auth/adapters/drizzle",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "profanease": "^2.0.3",
    "svelte-codemirror-editor": "^2.1.0",
    "svelte-sonner": "^1.1.1",
    "vite-plugin-mkcert": "^2.1.0"
